{
  "name": "aws-event-driven-application",
  "version": "1.0.0",
  "description": "Production-oriented AWS event-driven order processing platform using API Gateway, SNS, SQS, Lambda, DynamoDB, DLQs, idempotency, Terraform, and CI/CD.",
  "type": "module",
  "main": "src/functions/create-order/handler.js",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --verbose",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"docs/**/*.md\""
  },
  "keywords": [
    "aws",
    "event-driven",
    "serverless",
    "sqs",
    "sns",
    "lambda",
    "dynamodb",
    "idempotency",
    "dead-letter-queue",
    "terraform",
    "sre"
  ],
  "author": "Dineth",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.758.0",
    "@aws-sdk/client-sns": "^3.758.0",
    "@aws-sdk/client-sqs": "^3.758.0",
    "@aws-sdk/lib-dynamodb": "^3.758.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/jest": "^29.5.14",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/handler.js",
      "!src/lib/persistence/dynamodb-client.js",
      "!src/**/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 55,
        "functions": 75,
        "lines": 75,
        "statements": 75
      }
    }
  }
}
